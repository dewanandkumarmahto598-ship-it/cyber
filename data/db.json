    },
    {
      "id": "note_2",
      "u": "u_liam",
      "authorName": "Liam Chen",
      "authorPic": "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=150&auto=format&fit=crop&q=80",
      "title": "Spaces in between",
      "body": "Architecture is not just the stone or glass you erect. It is the breathing room left untouched inside the frame.",
      "c": 2,
      "t": 1792586403426,
      "likes": [
        "u_maya",
        "u_sofia",
        "u_elena"
      ],
      "commentsCount": 2
    },
    {
      "id": "note_3",
      "u": "u_elena",
      "authorName": "Elena Vance",
      "authorPic": "https://images.unsplash.com/photo-1517841905240-472988babdf9?w=150&auto=format&fit=crop&q=80",
      "title": "Pocket wisdom",
      "body": "Stop saving your favorite notebook for someday. Write on the first page today. Wear the scent, use the good pen.",
      "c": 4,
      "t": 1792577703426,
      "likes": [
        "u_maya"
      ],
      "commentsCount": 1
    },
    {
      "id": "note_4",
